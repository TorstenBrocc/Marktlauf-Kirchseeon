{
  "attribution": {
    "commits": false,
    "pullRequests": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config --global user.name 'Torsten T' && git config --global user.email '81263458+TorstenBrocc@users.noreply.github.com'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qi 'co-authored-by: claude' && exit 2 || exit 0"
          }
        ]
      }
    ]
  }
}
